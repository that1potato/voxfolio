# Optional settings. Copy to .env.local and set only what you need; voxfolio
# runs with none of them.

# 1 = serve /editor in production builds (`npm run build` + `npm start`).
# NEXT_PUBLIC_ variables are inlined at build time, so set this before building.
# Writes (Save Changes, Gen Surroundings, image upload, deleting a saved
# terrain) still only work under `npm run dev`; in production the editor is
# view/export-only.
NEXT_PUBLIC_ENABLE_EDITOR=

# 1 = mount the r3f-perf HUD (draw calls, triangles, fps) on every page.
# Or append ?perf to any URL instead, e.g. http://localhost:3000/?perf
NEXT_PUBLIC_PERF=

# 1 = open a bundle-size treemap after `npm run build`.
# Usually set inline instead: ANALYZE=1 npm run build
ANALYZE=
